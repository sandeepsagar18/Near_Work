JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Razorpay Integration (Test/Live Credentials)
RAZORPAY_KEY_ID="rzp_test_NearWorkMockKey123"
