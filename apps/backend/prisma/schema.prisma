generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum WorkerStatus {
  ONLINE
  OFFLINE
  BUSY
  ON_JOB
}

enum WorkerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  SEARCHING_WORKER
  WORKER_ASSIGNED
  WORKER_ACCEPTED
  WORKER_EN_ROUTE
  WORKER_ARRIVED
  SERVICE_STARTED
  SERVICE_COMPLETED
  PAYMENT_SETTLED
  COMPLETED
  CUSTOMER_CANCELLED
  WORKER_CANCELLED
  ADMIN_CANCELLED
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REFUND_PENDING
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String         @unique
  name          String
  passwordHash  String
  role          UserRole       @default(CUSTOMER)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  refreshToken  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  workerProfile WorkerProfile?
  adminProfile  AdminProfile?
  addresses     Address[]
  bookings      Booking[]      @relation("CustomerBookings")
  payments      Payment[]
  reviews       Review[]       @relation("CustomerReviews")
  notifications Notification[]
  tickets       SupportTicket[]
  chats         Chat[]         @relation("CustomerChats")
  chatMessages  ChatMessage[]  @relation("SenderMessages")
}

model WorkerProfile {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             WorkerStatus             @default(OFFLINE)
  verificationStatus WorkerVerificationStatus @default(PENDING)
  experienceYears    Int                      @default(1)
  workingRadiusKm    Float                    @default(15.0)
  currentLat         Float?
  currentLng         Float?
  address            String?
  idProofType        String?
  idProofUrl         String?
  bankAccountNumber  String?
  bankIfsc           String?
  totalJobsCompleted Int                      @default(0)
  averageRating      Float                    @default(5.0)
  totalReviews       Int                      @default(0)
  availableBalance   Float                    @default(0.0)
  pendingBalance     Float                    @default(0.0)
  totalWithdrawn     Float                    @default(0.0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Relationships
  skills             WorkerSkill[]
  availability       WorkerAvailability[]
  bookings           Booking[]                @relation("WorkerBookings")
  locations          WorkerLocation[]
  earnings           Earning[]
  payouts            Payout[]
  reviews            Review[]                 @relation("WorkerReviews")
  chats              Chat[]                   @relation("WorkerChats")
}

model AdminProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String     @default("Operations")
  permissions String     @default("ALL") // JSON or comma-delimited
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
}

model ServiceCategory {
  id          String        @id @default(uuid())
  name        String        @unique
  slug        String        @unique
  description String?
  icon        String?
  imageUrl    String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  services    Service[]
  workerSkills WorkerSkill[]
}

model Service {
  id              String          @id @default(uuid())
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  slug            String          @unique
  description     String
  basePrice       Float
  durationMinutes Int             @default(60)
  inclusions      String          // JSON array string of included items
  icon            String?
  imageUrl        String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bookings        Booking[]
}

model Address {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String    // Home, Work, Other
  addressLine String
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
}

model Booking {
  id                  String               @id @default(uuid())
  bookingNumber       String               @unique
  customerId          String
  customer            User                 @relation("CustomerBookings", fields: [customerId], references: [id])
  workerId            String?
  worker              WorkerProfile?       @relation("WorkerBookings", fields: [workerId], references: [id])
  serviceId           String
  service             Service              @relation(fields: [serviceId], references: [id])
  addressId           String
  address             Address              @relation(fields: [addressId], references: [id])
  status              BookingStatus        @default(CREATED)
  scheduledDate       String               // YYYY-MM-DD
  scheduledTimeSlot   String               // e.g., "10:00 AM"
  basePrice           Float
  visitCharge         Float                @default(50.0)
  taxAmount           Float                @default(0.0)
  discountAmount      Float                @default(0.0)
  extraChargeAmount   Float                @default(0.0)
  extraChargeReason   String?
  extraChargeApproved Boolean?
  totalAmount         Float
  otp                 String               // 4-digit service start verification OTP
  instructions        String?
  problemPhotos       String?              // JSON array
  beforePhotos        String?              // JSON array
  afterPhotos         String?              // JSON array
  assignedAt          DateTime?
  acceptedAt          DateTime?
  enRouteAt           DateTime?
  arrivedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  cancelledByRole     UserRole?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relationships
  statusHistory       BookingStatusHistory[]
  payment             Payment?
  refund              Refund?
  chat                Chat?
  review              Review?
  earning             Earning?
  invoice             Invoice?
  supportTickets      SupportTicket[]
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  note      String?
  changedBy String?       // userId or system
  createdAt DateTime      @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PAYMENT_PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  paymentMethod     String?       // UPI, Card, NetBanking, Wallet
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refund            Refund?
}

model Refund {
  id               String        @id @default(uuid())
  paymentId        String        @unique
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount           Float
  status           PaymentStatus @default(REFUND_PENDING)
  reason           String?
  razorpayRefundId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model WorkerLocation {
  id        String        @id @default(uuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  accuracy  Float?
  updatedAt DateTime      @default(now())
}

model WorkerAvailability {
  id        String        @id @default(uuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dayOfWeek Int           // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String        // "09:00"
  endTime   String        // "18:00"
  isOff     Boolean       @default(false)

  @@unique([workerId, dayOfWeek])
}

model WorkerSkill {
  id              String          @id @default(uuid())
  workerId        String
  worker          WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  experienceYears Int             @default(1)

  @@unique([workerId, categoryId])
}

model Review {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerReviews", fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile @relation("WorkerReviews", fields: [workerId], references: [id])
  rating     Int           // 1 to 5
  review     String?
  createdAt  DateTime      @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // e.g. BOOKING, PAYMENT, SYSTEM, CHAT
  isRead    Boolean  @default(false)
  data      String?  // JSON string
  createdAt DateTime @default(now())
}

model Chat {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerChats", fields: [customerId], references: [id])
  workerId   String
  worker     WorkerProfile @relation("WorkerChats", fields: [workerId], references: [id])
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages   ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SenderMessages", fields: [senderId], references: [id])
  message   String
  imageUrl  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Earning {
  id                 String        @id @default(uuid())
  workerId           String
  worker             WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  bookingId          String        @unique
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount        Float
  platformCommission Float
  netWorkerEarning   Float
  status             String        @default("SETTLED")
  createdAt          DateTime      @default(now())
}

model Payout {
  id            String        @id @default(uuid())
  payoutNumber  String        @unique
  workerId      String
  worker        WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount        Float
  status        PayoutStatus  @default(PENDING)
  bankAccount   String
  bankIfsc      String
  referenceId   String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Float
  minOrderValue  Float        @default(0.0)
  maxDiscount    Float?
  usageLimit     Int          @default(100)
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  workerId      String?
  subtotal      Float
  visitCharge   Float
  tax           Float
  discount      Float
  extraCharges  Float    @default(0.0)
  total         Float
  pdfUrl        String?
  createdAt     DateTime @default(now())
}

model SupportTicket {
  id          String         @id @default(uuid())
  ticketNumber String        @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?       @relation(fields: [bookingId], references: [id])
  category    String         // PAYMENT, WORKER, SERVICE, CANCELLATION, REFUND, OTHER
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  adminNotes  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AuditLog {
  id        String       @id @default(uuid())
  adminId   String
  admin     AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   String?      // JSON string
  ipAddress String?
  createdAt DateTime     @default(now())
}
